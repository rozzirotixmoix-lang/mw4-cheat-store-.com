---
import SectionHeader from '../SectionHeader.astro';
import Icon from '../icons/Icon.astro';
import { getCatalog } from '../../data/catalog';
import { formatPlanPrice } from '../../data/productPricing';
import { PRODUCTS_HUB_PATH } from '../../config/site';
import { useLocale } from '../../i18n';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const { locale, t, lp } = useLocale(Astro.currentLocale);
const others = getCatalog(locale).filter((entry) => entry.slug !== currentSlug);

const localeCopy = {
  en: {
    eyebrow: 'More products',
    title: 'Pairs well with',
    desc: 'Other tools from the same store, each with its own page and checkout.',
    from: 'From',
    all: 'Compare all products',
  },
  es: {
    eyebrow: 'Más productos',
    title: 'Combina bien con',
    desc: 'Otras herramientas de la misma tienda, cada una con su página y su pago.',
    from: 'Desde',
    all: 'Comparar todos los productos',
  },
  de: {
    eyebrow: 'Weitere Produkte',
    title: 'Passt gut zu',
    desc: 'Weitere Tools aus demselben Shop, jedes mit eigener Seite und Kaufabwicklung.',
    from: 'Ab',
    all: 'Alle Produkte vergleichen',
  },
  fr: {
    eyebrow: 'Autres produits',
    title: 'Se combine bien avec',
    desc: 'D’autres outils de la même boutique, chacun avec sa page et son paiement.',
    from: 'Dès',
    all: 'Comparer tous les produits',
  },
};

const copy = { ...localeCopy[locale] };
const crossSellDescByLocale: Record<typeof locale, Record<string, string>> = {
  en: {
    'hwid-spoofer': 'The other licenses sold here. Open one to see its page and its checkout.',
    ugc: 'UGC sits beside three other licenses. Each of those has its own write-up.',
    'skin-changer': 'The catalog beside this cosmetic client, with a separate page for each license.',
    elite: 'Utilities sold beside the cheat. Each one keeps a separate page.',
  },
  es: {
    'hwid-spoofer': 'Las otras licencias que se venden aquí. Abre una para ver su página y su pago.',
    ugc: 'UGC está junto a otras tres licencias. Cada una tiene su propia ficha.',
    'skin-changer': 'El catálogo junto a este cliente cosmético, con una página aparte para cada licencia.',
    elite: 'Utilidades vendidas junto al cheat. Cada una mantiene una página separada.',
  },
  de: {
    'hwid-spoofer': 'Die anderen Lizenzen, die hier verkauft werden. Öffnen Sie eine, um ihre Seite und den Checkout zu sehen.',
    ugc: 'UGC steht neben drei weiteren Lizenzen. Jede davon hat einen eigenen Text.',
    'skin-changer': 'Der Katalog neben diesem Kosmetik-Client, mit einer separaten Seite pro Lizenz.',
    elite: 'Utilities neben dem Cheat verkauft. Jede behält eine eigene Seite.',
  },
  fr: {
    'hwid-spoofer': 'Les autres licences vendues ici. Ouvrez-en une pour voir sa page et son paiement.',
    ugc: 'UGC est à côté de trois autres licences. Chacune a sa propre fiche.',
    'skin-changer': 'Le catalogue à côté de ce client cosmétique, avec une page séparée pour chaque licence.',
    elite: 'Utilitaires vendus à côté du cheat. Chacun garde une page distincte.',
  },
};
const slugCrossSellDesc = crossSellDescByLocale[locale]?.[currentSlug];
if (slugCrossSellDesc) copy.desc = slugCrossSellDesc;
---

{
  others.length > 0 && (
    <section class="product-cross-sell border-t border-border py-14 md:py-16" aria-labelledby="product-cross-sell-title">
      <div class="mx-auto max-w-6xl px-5">
        <SectionHeader eyebrow={copy.eyebrow} title={copy.title} desc={copy.desc} titleId="product-cross-sell-title" />

        <ul class="fill-grid mt-10 list-none gap-4 p-0" data-reveal-stagger>
          {others.map((entry) => (
            <li>
              <a
                href={lp(entry.path)}
                class="group flex h-full flex-col gap-3 rounded-2xl border border-border bg-card p-5 transition-colors hover:border-primary/45"
              >
                <span class="flex items-center gap-3">
                  <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/12">
                    <Icon name={entry.icon} size={19} class="icon-app--primary" />
                  </span>
                  <span class="min-w-0">
                    <span class="block font-[family-name:var(--font-heading)] text-lg font-bold leading-tight text-foreground group-hover:text-primary">
                      {entry.anchorLabel}
                    </span>
                    <span class="block text-xs font-medium text-muted-foreground">
                      {copy.from} {formatPlanPrice(entry.fromPriceUsd)}
                    </span>
                  </span>
                </span>
                <span class="text-sm leading-relaxed text-muted-foreground">{entry.page.desc}</span>
                <span class="mt-auto inline-flex max-w-full min-w-0 items-center text-sm font-semibold text-primary-text">
                  {t.products.viewDetails}: {entry.anchorLabel}
                </span>
              </a>
            </li>
          ))}
        </ul>

        <p class="mt-10 text-center">
          <a href={lp(PRODUCTS_HUB_PATH)} class="inline-flex min-h-11 items-center justify-center px-4 text-sm font-semibold text-primary-text hover:underline">
            {copy.all}
          </a>
        </p>
      </div>
    </section>
  )
}
