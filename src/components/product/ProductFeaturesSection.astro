---
import SectionHeader from '../SectionHeader.astro';
import Icon from '../icons/Icon.astro';
import { useLocale } from '../../i18n';

interface Props {
  features: string[];
  productName: string;
  section?: { eyebrow: string; title: string; desc: string };
}

const { features, productName, section } = Astro.props;
const { locale } = useLocale(Astro.currentLocale);

const localeCopy = {
  en: {
    eyebrow: 'Modules',
    title: "What's included",
    desc: `The full option list for ${productName}. mw4 soft aim tool style controls cover smoothness, bones, and distance. The phrase undetected mw4 aimbot is a search label only: read the live banner instead of assuming status.`,
  },
  es: {
    eyebrow: 'Módulos',
    title: 'Qué incluye',
    desc: `La lista completa de opciones de ${productName}. Los controles al estilo mw4 soft aim tool cubren suavidad, huesos y distancia. La frase undetected mw4 aimbot es solo una etiqueta de búsqueda: lee el banner en vivo en lugar de asumir el estado.`,
  },
  de: {
    eyebrow: 'Module',
    title: 'Das ist enthalten',
    desc: `Die vollständige Optionsliste für ${productName}. mw4 soft aim tool Regler decken Glättung, Knochen und Distanz ab. Der Ausdruck undetected mw4 aimbot ist nur ein Suchlabel: Lesen Sie das Live-Banner statt den Status zu vermuten.`,
  },
  fr: {
    eyebrow: 'Modules',
    title: 'Ce qui est inclus',
    desc: `La liste complète des options pour ${productName}. Les réglages de type mw4 soft aim tool couvrent lissage, os et distance. L'expression undetected mw4 aimbot n'est qu'une étiquette de recherche: lisez la bannière en direct au lieu de supposer le statut.`,
  },
};

const copy = section
  ? { eyebrow: section.eyebrow, title: section.title, desc: section.desc }
  : localeCopy[locale];
---

<section id="product-features" class="py-12 md:py-16" aria-labelledby="product-features-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      eyebrow={copy.eyebrow}
      title={copy.title}
      desc={copy.desc}
      titleId="product-features-title"
    />

    <ul class="product-detail__features mt-10 grid gap-2 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {
        features.map((feature) => (
          <li
            class="flex items-start gap-2.5 rounded-xl border border-border/80 bg-muted/15 px-4 py-3 text-sm text-muted-foreground transition-colors hover:border-primary/25 hover:bg-muted/30"
          >
            <Icon name="check" size={15} class="product-feature-check mt-0.5 shrink-0 icon-app--primary" />
            <span>{feature}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
