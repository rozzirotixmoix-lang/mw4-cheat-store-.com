---
import { useLocale } from '../i18n';
import { ROUTES } from '../utils/path';
import { Button } from '@/components/starwind/button';
import AnimatedThemeSwitch from './AnimatedThemeSwitch.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import BrandLogo from './BrandLogo.astro';
import BrandWordmark from './BrandWordmark.astro';

const { t, lp } = useLocale(Astro.currentLocale);

const productUrl = lp(ROUTES.products);
const productCtaLabel = t.ui.browseCheatsNavMobile;

/** Same routes and labels as the old side menu (short labels fit the header bar). */
const headerNavLinks: {
  href: string;
  label: string;
  ariaLabel?: string;
  scrollTarget?: string;
}[] = [
  { href: '/', label: t.ui.navHome, ariaLabel: t.ui.homeAria },
  ...t.nav.map((link) => ({
    href: link.href,
    label: link.shortLabel ?? link.label,
    ariaLabel: link.sheetLabel ?? link.ariaLabel ?? link.label,
    scrollTarget: link.scrollTarget,
  })),
];

interface Props {
  brandLogoAlt?: string;
}

const { brandLogoAlt } = Astro.props;

const productCtaClass = 'header-product-cta shrink-0 rounded-md';
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div
    class="flex justify-center px-3 pt-[max(0.75rem,env(safe-area-inset-top))] sm:px-5 sm:pt-4"
    data-floating-nav
  >
    <div
      class="site-header pointer-events-auto relative flex h-11 w-full max-w-6xl min-w-0 items-center gap-2 rounded-2xl border border-border/70 bg-background/95 px-2 text-foreground shadow-lg shadow-black/15 backdrop-blur-xl sm:h-12 sm:gap-2 sm:px-4 lg:min-h-[3.25rem] lg:px-5 lg:py-1.5 lg:border-border/40 lg:bg-background/35 lg:shadow-md lg:shadow-black/5 lg:backdrop-blur-2xl lg:supports-[backdrop-filter]:bg-background/25 lg:dark:border-white/10 lg:dark:bg-background/20 lg:dark:shadow-black/25"
    >
      <a
        href={lp('/')}
        class="site-header__brand inline-flex min-w-0 shrink-0 items-center gap-1.5 sm:gap-2"
        aria-label={`${t.site.name} home`}
      >
        <BrandLogo size={20} class="size-5 shrink-0 rounded-md" priority alt={brandLogoAlt} />
        <BrandWordmark class="header-brand-wordmark min-w-0 max-sm:hidden" />
      </a>

      <nav
        class="header-primary-nav flex min-w-0 flex-1 items-center justify-center gap-x-2 overflow-x-auto overscroll-x-contain px-0.5 [-ms-overflow-style:none] [scrollbar-width:none] sm:gap-x-3 lg:gap-x-5 xl:gap-x-6 [&::-webkit-scrollbar]:hidden"
        aria-label="Primary"
      >
        {headerNavLinks.map((link) => (
          <a
            href={lp(link.href)}
            class="header-nav-link shrink-0 whitespace-nowrap text-[0.6875rem] font-medium text-muted-foreground transition-colors sm:text-xs lg:text-sm"
            data-nav-link
            aria-label={link.ariaLabel}
            {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex shrink-0 items-center justify-end gap-1.5 sm:gap-2">
        <AnimatedThemeSwitch size="sm" ariaLabel={t.ui.themeLight} class="shrink-0" />

        <Button as="a" href={productUrl} variant="primary" class={productCtaClass}>
          {productCtaLabel}
        </Button>

        <div class="header-lang-slot">
          <LanguageSwitcher variant="compact" />
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .header-lang-slot {
    width: 4.5rem;
    flex: 0 0 4.5rem;
  }

  :global(.site-header .site-header__brand .brand-wordmark),
  :global(.site-header .site-header__brand .header-brand-wordmark) {
    font-family: 'Orbitron', sans-serif !important;
    font-size: 0.6875rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.03em !important;
    line-height: 1 !important;
    color: inherit;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    :global(.site-header .site-header__brand .brand-wordmark),
    :global(.site-header .site-header__brand .header-brand-wordmark) {
      font-size: 0.75rem !important;
    }
  }

  :global(.site-header a.header-product-cta),
  :global(.site-header button.header-product-cta) {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-height: 1.75rem !important;
    height: 1.75rem !important;
    padding: 0 0.625rem !important;
    font-family: var(--font-sans) !important;
    font-size: 0.6875rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.01em !important;
    line-height: 1 !important;
    text-transform: none !important;
    white-space: nowrap !important;
  }

  @media (min-width: 640px) {
    :global(.site-header a.header-product-cta),
    :global(.site-header button.header-product-cta) {
      min-height: 2rem !important;
      height: 2rem !important;
      padding: 0 0.75rem !important;
      font-size: 0.75rem !important;
    }
  }

  .header-nav-link:hover,
  .header-nav-link:focus-visible {
    color: var(--color-primary);
    outline: none;
  }

  .header-nav-link:focus-visible {
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--color-primary) 40%, transparent);
    border-radius: 0.25rem;
  }

  :global(a.header-nav-link[data-nav-link].is-active) {
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
