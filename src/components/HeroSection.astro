---
import { useLocale } from '../i18n';
import { ROUTES } from '../utils/path';
import { compatibilityIcons, heroStatIcons, heroStatusPillIcons } from '../data/sectionIcons';
import ResponsiveImage from './ResponsiveImage.astro';
import { HERO_IMAGE_SIZES, HERO_IMAGE_WIDTHS } from '../utils/responsiveImage';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Badge } from '@/components/starwind/badge';
import { stripCommaColon } from '../config/seo';

const { t, lp } = useLocale(Astro.currentLocale);

/** Swap or add slides here. Files live in public/images/gameplay/. */
const HERO_SLIDES = [
  {
    src: '/images/gameplay/modern-warfare-4-esp-scope-gameplay.webp',
    alt: 'Modern Warfare 4 scoped rifle view with green enemy ESP boxes in a wooden warehouse corridor.',
    width: 1024,
    height: 576,
  },
  {
    src: '/images/gameplay/modern-warfare-4-visuals-settings-panel.webp',
    alt: 'Modern Warfare 4 Visuals tab with player box, skeleton, health bar, and distance sliders on a dark purple menu.',
    width: 1024,
    height: 576,
  },
  {
    src: '/images/gameplay/modern-warfare-4-visuals-settings-interface.webp',
    alt: 'Modern Warfare 4 Visuals menu showing portal, ores, traps, chests, and items distance controls in three columns.',
    width: 1024,
    height: 576,
  },
] as const;

const h = t.hero;
const heroTitleLead = stripCommaColon(h.titleLead);
const heroTitleAccent = stripCommaColon(h.titleAccent);
const heroSubtitle = stripCommaColon(h.subtitle);

const heroMarqueePills = [
  ...h.statusPills.map((label, i) => ({
    label,
    icon: heroStatusPillIcons[i] ?? 'check',
  })),
  ...t.compatibility.items.map((label, i) => ({
    label,
    icon: compatibilityIcons[i] ?? 'check',
  })),
];

---

<section
  id="hero"
  class="relative overflow-hidden border-b border-border"
  aria-labelledby="hero-title"
>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,var(--primary)_0%,transparent_55%)] opacity-20" aria-hidden="true" />

  <div class="relative mx-auto flex max-w-6xl flex-col justify-center px-5">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="w-full min-w-0 max-w-xl space-y-6 text-left md:space-y-7 lg:max-w-none">
        <Badge variant="secondary" class="uppercase tracking-wider">{h.eyebrow}</Badge>

        <h1
          id="hero-title"
          class="max-w-full text-lg font-bold leading-snug tracking-normal text-foreground sm:text-xl lg:text-2xl"
        >
          {heroTitleLead}{' '}<span class="hero-title-accent">{heroTitleAccent}</span>
        </h1>

        <p class="max-w-xl text-sm leading-relaxed text-muted-foreground md:text-base">
          {heroSubtitle}
        </p>

        <div class="flex flex-wrap justify-start gap-3 sm:gap-4">
          <Button
            as="a"
            href={lp(ROUTES.products)}
            data-scroll-target="products"
            variant="primary"
            size="lg"
            class="rounded-xl"
          >
            {h.ctaPrimary}
            <Icon name="arrowRight" size={18} />
          </Button>
        </div>
      </div>

      <div class="mx-auto flex w-full max-w-xl flex-col items-center gap-5 lg:mx-0 lg:max-w-none lg:items-end">
        {HERO_SLIDES.length > 0 && (
          <div class="hero-slider relative w-full rounded-xl border border-border bg-card p-2 shadow-sm">
            <div class="hero-fade relative aspect-[16/10] overflow-hidden rounded-lg bg-muted/30" data-hero-fade>
              {HERO_SLIDES.map((slide, i) => (
                <figure
                  class:list={['hero-fade__slide m-0', i === 0 && 'is-active']}
                  data-hero-fade-slide
                >
                  <ResponsiveImage
                    src={slide.src}
                    alt={slide.alt}
                    width={slide.width}
                    height={slide.height}
                    widths={HERO_IMAGE_WIDTHS}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchPriority={i === 0 ? 'high' : 'low'}
                    sizes={HERO_IMAGE_SIZES}
                    class="h-full w-full object-cover"
                  />
                </figure>
              ))}
              <div class="hero-fade__overlay" aria-hidden="true"></div>
            </div>
          </div>
        )}
        <div class="grid w-full grid-cols-1 gap-2.5 sm:grid-cols-2 sm:gap-3 md:grid-cols-4 lg:grid-cols-2">
          {h.metrics.map((m, i) => (
            <div class="flex min-w-0 items-center gap-3 rounded-xl border border-border/80 bg-card/70 px-3 py-3 shadow-sm shadow-black/10 transition-colors hover:border-primary/40">
              <span
                class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/15 ring-1 ring-inset ring-primary/25"
                aria-hidden="true"
              >
                <Icon name={heroStatIcons[i] ?? 'check'} size={18} />
              </span>
              <div class="min-w-0">
                <p class="font-[family-name:var(--font-heading)] text-base font-bold leading-none tracking-tight text-foreground">{m.strong}</p>
                <p class="mt-1 text-xs leading-snug text-muted-foreground [overflow-wrap:break-word]">{m.label}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div
    class="hero-marquee relative left-1/2 mt-10 w-screen max-w-[100vw] -translate-x-1/2 md:mt-12 lg:mt-14"
    aria-label="Features and platform support"
  >
    <div class="hero-marquee__track">
      {heroMarqueePills.map((pill) => (
        <Badge variant="outline" class="group/badge shrink-0 gap-1 py-0.5 pl-1.5 pr-2.5 text-xs whitespace-nowrap">
          <Icon name={pill.icon} size={13} />
          {pill.label}
        </Badge>
      ))}
      <span class="hero-marquee__repeat" aria-hidden="true">
        {heroMarqueePills.map((pill) => (
          <Badge variant="outline" class="group/badge shrink-0 py-0.5 px-2.5 text-xs whitespace-nowrap">
            {pill.label}
          </Badge>
        ))}
      </span>
    </div>
  </div>
</section>

<style>
  #hero-title {
    font-size: clamp(1.5rem, 3.4vw, 2.6rem) !important;
    font-weight: 800 !important;
    line-height: 1.12 !important;
    letter-spacing: -0.01em !important;
    max-width: 900px;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  #hero-title + p {
    font-size: clamp(0.89rem, 1.42vw, 1.02rem);
    line-height: 1.6;
    max-width: 680px;
    margin-top: 1rem !important;
    color: color-mix(in oklab, var(--muted-foreground) 40%, #f4f4f5);
  }

  .hero-fade__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease;
  }

  .hero-fade__slide :global(picture),
  .hero-fade__slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-fade__slide:first-child {
    position: relative;
  }

  .hero-fade__slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  .hero-fade__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: rgb(0 0 0 / 28%);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fade__slide {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector('[data-hero-fade]');
  if (root && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const slides = [...root.querySelectorAll('[data-hero-fade-slide]')];
    if (slides.length > 1) {
      let index = 0;
      window.setInterval(() => {
        slides[index]?.classList.remove('is-active');
        index = (index + 1) % slides.length;
        slides[index]?.classList.add('is-active');
      }, 3000);
    }
  }
</script>

